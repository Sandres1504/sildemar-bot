# ============================================================
# Variables de entorno para el Bot Sildemar
# NO poner valores reales aquí, solo placeholders
# ============================================================

# --- MySQL (inventario, cPanel) ---
DB_HOST=tu_host_mysql
DB_PORT=3306
DB_NAME=storesil_sildemar
DB_USER=tu_usuario_mysql
DB_PASSWORD=tu_password_mysql

# --- PostgreSQL (Supabase, sesión Baileys) ---
DATABASE_URL=postgresql://usuario:password@host:5432/basedatos

# --- Google Gemini (IA conversacional) ---
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# --- Gerencia (notificaciones de pedidos y consultas) ---
GERENTE_DELIVERY_PHONE=04142149796
GERENTE_SHIPPING_PHONE=04142522920

# --- Servidor HTTP (Render asigna el puerto automáticamente) ---
PORT=3000